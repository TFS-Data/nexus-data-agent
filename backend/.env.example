# ============================================================
#  NEXUS DATA AGENT — Backend — Variáveis de Ambiente
#  Copie este arquivo para .env e preencha com suas credenciais
# ============================================================

# ─── Azure AI Foundry ──────────────────────────────────────
# Endpoint do seu projeto no Azure AI Foundry
# Exemplo: https://meu-recurso.services.ai.azure.com/api/projects/meu-projeto/openai/v1
AZURE_AI_FOUNDRY_ENDPOINT=https://seu-recurso.services.ai.azure.com/api/projects/seu-projeto/openai/v1

# Endpoint da API OpenAI do Azure (opcional, se usar rota alternativa)
AZURE_OPENAI_ENDPOINT=https://seu-recurso.openai.azure.com/

# Nome do deployment do modelo configurado no Azure AI Foundry
# Exemplos: gpt-4o, gpt-4.1, gpt-35-turbo
AZURE_MODEL_DEPLOYMENT=gpt-4o

# Chave de API do Azure AI Foundry
# Encontre em: Azure AI Foundry > seu projeto > Playgrounds > View Code
AZURE_API_KEY=SUA_CHAVE_AQUI

# ─── Configurações da API Backend ─────────────────────────
# Prefixo da versão da API REST
API_V1_STR=/api/v1

# Nome do projeto exibido na documentação automática (/docs)
PROJECT_NAME="Nexus Data Agent"

# Origens permitidas para CORS (frontend)
# Em produção, substitua pelo domínio real
CORS_ORIGINS=["http://localhost:3000"]
