# ============================================================
#  NEXUS DATA AGENT — Backend — Variáveis de Ambiente
#  Copie este arquivo para .env e preencha com suas credenciais
# ============================================================

# ─── Azure AI Foundry ──────────────────────────────────────
# Endpoint do seu projeto no Azure AI Foundry.
# Formato: https://<recurso>.services.ai.azure.com/api/projects/<projeto>/openai/v1
#
# IMPORTANTE: O endpoint já inclui "/openai/v1" — NÃO adicione "/chat/completions"
# O SDK da OpenAI concatena o path automaticamente.
#
# Como encontrar: Azure AI Foundry > seu projeto > Playgrounds > View Code
AZURE_AI_FOUNDRY_ENDPOINT=https://seu-recurso.services.ai.azure.com/api/projects/seu-projeto/openai/v1

# Endpoint legacy OpenAI do Azure (opcional, não usado por padrão)
AZURE_OPENAI_ENDPOINT=https://seu-recurso.openai.azure.com/

# Nome exato do deployment configurado no Azure AI Foundry
# Exemplos: gpt-4o, gpt-4.1, gpt-35-turbo, gpt-4o-mini
AZURE_MODEL_DEPLOYMENT=gpt-4o

# Chave de API do Azure AI Foundry
# Encontre em: Azure AI Foundry > seu projeto > Playgrounds > View Code > API Key
AZURE_API_KEY=SUA_CHAVE_AQUI

# ─── Configurações da API Backend ─────────────────────────
API_V1_STR=/api/v1
PROJECT_NAME="Nexus Data Agent"

# Origens permitidas para CORS — inclua a URL do seu frontend
# Em produção substitua pelo domínio real (sem trailing slash)
CORS_ORIGINS=["http://localhost:3000"]
